{
  "manifest_version": 3,
  "name": "Club Companion FC",
  "version": "0.7.0",
  "description": "Organize seu clube, planeje SBCs e registre preços localmente.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "Club Companion FC",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'; form-action 'none';"
  }
}
